+    def sum(self, field: str, cond: Optional[QueryLike] = None) -> Union[int, float]:
+        """
+        Calculate the sum of a numeric field for documents matching a query.
+
+        :param field: the field to sum
+        :param cond: the condition to filter documents (optional)
+        :returns: sum of the field values
+        :raises ValueError: if field contains non-numeric values
+        """
+        documents = self.search(cond) if cond else self.all()
+        total = 0
+        for doc in documents:
+            if field in doc:
+                value = doc[field]
+                if not isinstance(value, (int, float)):
+                    raise ValueError(f"Field '{field}' contains non-numeric value: {value}")
+                total += value
+        return total
+
+    def avg(self, field: str, cond: Optional[QueryLike] = None) -> Union[int, float]:
+        """
+        Calculate the average of a numeric field for documents matching a query.
+
+        :param field: the field to average
+        :param cond: the condition to filter documents (optional)
+        :returns: average of the field values
+        :raises ValueError: if field contains non-numeric values or no documents match
+        """
+        documents = self.search(cond) if cond else self.all()
+        if not documents:
+            raise ValueError("No documents found to calculate average")
+
+        total = 0
+        count = 0
+        for doc in documents:
+            if field in doc:
+                value = doc[field]
+                if not isinstance(value, (int, float)):
+                    raise ValueError(f"Field '{field}' contains non-numeric value: {value}")
+                total += value
+                count += 1
+
+        if count == 0:
+            raise ValueError(f"No documents contain field '{field}'")
+
+        return total / count
+
+    def min(self, field: str, cond: Optional[QueryLike] = None):
+        """
+        Find the minimum value of a field for documents matching a query.
+
+        :param field: the field to find minimum of
+        :param cond: the condition to filter documents (optional)
+        :returns: minimum value of the field
+        :raises ValueError: if no documents match or field doesn't exist
+        """
+        documents = self.search(cond) if cond else self.all()
+        if not documents:
+            raise ValueError("No documents found")
+
+        values = []
+        for doc in documents:
+            if field in doc:
+                values.append(doc[field])
+
+        if not values:
+            raise ValueError(f"No documents contain field '{field}'")
+
+        return min(values)
+
+    def max(self, field: str, cond: Optional[QueryLike] = None):
+        """
+        Find the maximum value of a field for documents matching a query.
+
+        :param field: the field to find maximum of
+        :param cond: the condition to filter documents (optional)
+        :returns: maximum value of the field
+        :raises ValueError: if no documents match or field doesn't exist
+        """
+        documents = self.search(cond) if cond else self.all()
+        if not documents:
+            raise ValueError("No documents found")
+
+        values = []
+        for doc in documents:
+            if field in doc:
+                values.append(doc[field])
+
+        if not values:
+            raise ValueError(f"No documents contain field '{field}'")
+
+        return max(values)
+
+    def distinct(self, field: str, cond: Optional[QueryLike] = None) -> List:
+        """
+        Get distinct values of a field for documents matching a query.
+
+        :param field: the field to get distinct values of
+        :param cond: the condition to filter documents (optional)
+        :returns: list of distinct values
+        """
+        documents = self.search(cond) if cond else self.all()
+        values = set()
+        for doc in documents:
+            if field in doc:
+                value = doc[field]
+                # Handle unhashable types by converting to tuple if needed
+                if isinstance(value, (list, dict)):
+                    if isinstance(value, list):
+                        values.add(tuple(value))
+                    else:
+                        values.add(tuple(sorted(value.items())))
+                else:
+                    values.add(value)
+
+        # Convert back from tuples if needed
+        result = []
+        for value in values:
+            if isinstance(value, tuple):
+                # Check if this was originally a list or dict
+                try:
+                    result.append(list(value))
+                except (TypeError, ValueError):
+                    # If conversion fails, it was probably a dict
+                    result.append(dict(value))
+            else:
+                result.append(value)
+
+        return result
+
