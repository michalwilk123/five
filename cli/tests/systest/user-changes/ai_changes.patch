+def test_sum(db: TinyDB):
+    # Test sum with condition
+    assert db.sum('int', where('char') == 'a') == 1
+    assert db.sum('int', where('int') == 1) == 3
+
+    # Test sum without condition (all documents)
+    assert db.sum('int') == 6  # 1 + 1 + 1 + 3 = 6
+
+    # Test sum with non-existent field
+    assert db.sum('nonexistent') == 0
+
+    # Test sum with non-numeric values
+    with pytest.raises(ValueError, match="contains non-numeric value"):
+        db.sum('char')
+
+
+def test_avg(db: TinyDB):
+    # Test avg with condition
+    assert db.avg('int', where('char') == 'a') == 1.0
+    assert db.avg('int', where('int') == 1) == 1.0
+
+    # Test avg without condition (all documents)
+    assert db.avg('int') == 1.5  # (1 + 1 + 1 + 3) / 4 = 1.5
+
+    # Test avg with no matching documents
+    with pytest.raises(ValueError, match="No documents found"):
+        db.avg('int', where('char') == 'z')
+
+    # Test avg with non-existent field
+    with pytest.raises(ValueError, match="No documents contain field"):
+        db.avg('nonexistent')
+
+    # Test avg with non-numeric values
+    with pytest.raises(ValueError, match="contains non-numeric value"):
+        db.avg('char')
+
+
+def test_min(db: TinyDB):
+    # Test min with condition
+    assert db.min('int', where('char') == 'a') == 1
+    assert db.min('char', where('int') == 1) == 'a'
+
+    # Test min without condition (all documents)
+    assert db.min('int') == 1
+    assert db.min('char') == 'a'
+
+    # Test min with no matching documents
+    with pytest.raises(ValueError, match="No documents found"):
+        db.min('int', where('char') == 'z')
+
+    # Test min with non-existent field
+    with pytest.raises(ValueError, match="No documents contain field"):
+        db.min('nonexistent')
+
+
+def test_max(db: TinyDB):
+    # Test max with condition
+    assert db.max('int', where('char') == 'a') == 1
+    assert db.max('char', where('int') == 1) == 'c'
+
+    # Test max without condition (all documents)
+    assert db.max('int') == 3
+    assert db.max('char') == 'c'
+
+    # Test max with no matching documents
+    with pytest.raises(ValueError, match="No documents found"):
+        db.max('int', where('char') == 'z')
+
+    # Test max with non-existent field
+    with pytest.raises(ValueError, match="No documents contain field"):
+        db.max('nonexistent')
+
+
+def test_distinct(db: TinyDB):
+    # Test distinct with condition
+    distinct_ints = db.distinct('int', where('char') == 'a')
+    assert len(distinct_ints) == 1
+    assert 1 in distinct_ints
+
+    # Test distinct without condition (all documents)
+    distinct_ints = db.distinct('int')
+    assert len(distinct_ints) == 2
+    assert 1 in distinct_ints and 3 in distinct_ints
+
+    distinct_chars = db.distinct('char')
+    assert len(distinct_chars) == 3
+    assert 'a' in distinct_chars and 'b' in distinct_chars and 'c' in distinct_chars
+
+    # Test distinct with non-existent field
+    assert db.distinct('nonexistent') == []
+
+    # Test distinct with no matching documents
+    assert db.distinct('int', where('char') == 'z') == []
+
+
+def test_statistical_methods_with_empty_db():
+    """Test statistical methods with empty database"""
+    from tinydb import TinyDB
+    from tinydb.storages import MemoryStorage
+
+    empty_db = TinyDB(storage=MemoryStorage())
+
+    # Test with empty database
+    assert empty_db.sum('int') == 0
+
+    with pytest.raises(ValueError, match="No documents found"):
+        empty_db.avg('int')
+
+    with pytest.raises(ValueError, match="No documents found"):
+        empty_db.min('int')
+
+    with pytest.raises(ValueError, match="No documents found"):
+        empty_db.max('int')
+
+    assert empty_db.distinct('int') == []
+
+
+def test_statistical_methods_with_complex_data():
+    """Test statistical methods with more complex data types"""
+    from tinydb import TinyDB
+    from tinydb.storages import MemoryStorage
+
+    db = TinyDB(storage=MemoryStorage())
+
+    # Insert test data with lists and dicts
+    db.insert({'nums': [1, 2, 3], 'info': {'name': 'test1'}})
+    db.insert({'nums': [4, 5, 6], 'info': {'name': 'test2'}})
+    db.insert({'nums': [1, 2, 3], 'info': {'name': 'test1'}})  # Duplicate for testing
+
+    # Test distinct with complex types
+    distinct_nums = db.distinct('nums')
+    assert len(distinct_nums) == 2  # Should handle duplicate [1,2,3]
+
+    distinct_info = db.distinct('info')
+    assert len(distinct_info) == 2
+
+
