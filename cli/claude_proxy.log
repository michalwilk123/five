            "content": "#!/usr/bin/env tclsh\n\n# Hangman game in TCL\n# Following best practices with proper error handling and clean code structure\n\n# Word list for the game\nset word_list {\n    PYTHON COMPUTER PROGRAMMING KEYBOARD MONITOR\n    SOFTWARE HARDWARE INTERNET WEBSITE DATABASE\n    ALGORITHM FUNCTION VARIABLE DEBUGGING TERMINAL\n}\n\n# Hangman ASCII art stages\nset hangman_stages {\n    \"\"\n    \"  +---+\\n      |\\n      |\\n      |\\n      |\\n      |\\n=========\"\n    \"  +---+\\n  |   |\\n      |\\n      |\\n      |\\n      |\\n=========\"\n    \"  +---+\\n  |   |\\n  O   |\\n      |\\n      |\\n      |\\n=========\"\n    \"  +---+\\n  |   |\\n  O   |\\n  |   |\\n      |\\n      |\\n=========\"\n    \"  +---+\\n  |   |\\n  O   |\\n /|   |\\n      |\\n      |\\n=========\"\n    \"  +---+\\n  |   |\\n  O   |\\n /|\\\\  |\\n      |\\n      |\\n=========\"\n    \"  +---+\\n  |   |\\n  O   |\\n /|\\\\  |\\n /    |\\n      |\\n=========\"\n    \"  +---+\\n  |   |\\n  O   |\\n /|\\\\  |\\n / \\\\  |\\n      |\\n=========\"\n}\n\n# Constants\nset MAX_WRONG 6\n\nproc random_word {} {\n    global word_list\n    set index [expr {int(rand() * [llength $word_list])}]\n    return [lindex $word_list $index]\n}\n\nproc is_letter_guessed {letter guessed_letters} {\n    return [expr {[lsearch -exact $guessed_letters $letter] != -1}]\n}\n\nproc is_word_guessed {word guessed_letters} {\n    foreach letter [split $word \"\"] {\n        if {![is_letter_guessed $letter $guessed_letters]} {\n            return 0\n        }\n    }\n    return 1\n}\n\nproc display_word {word guessed_letters} {\n    set display \"\"\n    foreach letter [split $word \"\"] {\n        if {[is_letter_guessed $letter $guessed_letters]} {\n            append display \"$letter \"\n        } else {\n            append display \"_ \"\n        }\n    }\n    return [string trimright $display]\n}\n\nproc format_guessed_letters {guessed_letters} {\n    if {[llength $guessed_letters] == 0} {\n        return \"\"\n    }\n    return [join [lsort $guessed_letters] \", \"]\n}\n\nproc get_valid_guess {guessed_letters} {\n    while {1} {\n        puts -nonewline \"Enter a letter: \"\n        flush stdout\n\n        if {[gets stdin input] == -1} {\n            # Handle EOF (Ctrl+D)\n            puts \"\\nExiting game...\"\n            exit 0\n        }\n\n        set input [string trim $input]\n        set input [string toupper $input]\n\n        # Validate input\n        if {[string length $input] != 1} {\n            puts \"Please enter a single letter.\"\n            continue\n        }\n\n        if {![string is alpha $input]} {\n            puts \"Please enter a single letter.\"\n            continue\n        }\n\n        # Check if already guessed\n        if {[is_letter_guessed $input $guessed_letters]} {\n            puts \"You already guessed that letter.\"\n            continue\n        }\n\n        return $input\n    }\n}\n\nproc print_game_state {word guessed_letters wrong_guesses} {\n    global hangman_stages MAX_WRONG\n\n    puts \"\\n[lindex $hangman_stages $wrong_guesses]\"\n    puts \"Word: [display_word $word $guessed_letters]\"\n    puts \"Wrong guesses: $wrong_guesses/$MAX_WRONG\"\n\n    if {[llength $guessed_letters] > 0} {\n        puts \"Guessed letters: [format_guessed_letters $guessed_letters]\"\n    }\n}\n\nproc play_hangman {} {\n    global MAX_WRONG hangman_stages\n\n    # Initialize game state\n    set word [random_word]\n    set guessed_letters {}\n    set wrong_guesses 0\n\n    puts \"Welcome to Hangman!\"\n    puts \"Guess the word letter by letter.\"\n\n    # Main game loop\n    while {$wrong_guesses < $MAX_WRONG} {\n        print_game_state $word $guessed_letters $wrong_guesses\n\n        # Check win condition\n        if {[is_word_guessed $word $guessed_letters]} {\n            puts \"\\nCongratulations! You guessed the word: $word\"\n            return 1\n        }\n\n        # Get player guess\n        set guess [get_valid_guess $guessed_letters]\n        lappend guessed_letters $guess\n\n        # Check if guess is correct\n        if {[string first $guess $word] != -1} {\n            puts \"Good guess! '$guess' is in the word.\"\n        } else {\n            puts \"Sorry, '$guess' is not in the word.\"\n            incr wrong_guesses\n        }\n    }\n\n    # Game over - player lost\n    puts \"\\n[lindex $hangman_stages $wrong_guesses]\"\n    puts \"Game Over! The word was: $word\"\n    return 0\n}\n\nproc ask_play_again {} {\n    while {1} {\n        puts -nonewline \"\\nPlay again? (y/n): \"\n        flush stdout\n\n        if {[gets stdin response] == -1} {\n            # Handle EOF (Ctrl+D)\n            puts \"\\nExiting game...\"\n            return 0\n        }\n\n        set response [string trim [string tolower $response]]\n\n        if {$response eq \"y\" || $response eq \"yes\"} {\n            return 1\n        } elseif {$response eq \"n\" || $response eq \"no\"} {\n            return 0\n        } else {\n            puts \"Please enter 'y' or 'n'.\"\n        }\n    }\n}\n\n# Main program\nproc main {} {\n    # Seed random number generator\n    expr {srand([clock seconds])}\n\n    # Game loop\n    while {1} {\n        play_hangman\n\n        if {![ask_play_again]} {\n            puts \"Thanks for playing!\"\n            break\n        }\n    }\n}\n\n# Run the game if this script is executed directly\nif {[info exists argv0] && $argv0 eq [info script]} {\n    main\n}"
