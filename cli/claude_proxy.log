            "content": "with Ada.Text_IO;\nwith Ada.Strings.Unbounded;\nwith Ada.Strings.Maps;\nwith Ada.Characters.Handling;\nwith Ada.Numerics.Discrete_Random;\nwith Ada.Containers.Indefinite_Vectors;\n\nprocedure Hangman is\n   use Ada.Text_IO;\n   use Ada.Strings.Unbounded;\n   use Ada.Characters.Handling;\n\n   package String_Vectors is new Ada.Containers.Indefinite_Vectors\n     (Index_Type   => Natural,\n      Element_Type => String);\n   use String_Vectors;\n\n   subtype Word_Range is Natural range 1 .. 15;\n   package Random_Word is new Ada.Numerics.Discrete_Random (Word_Range);\n   Word_Gen : Random_Word.Generator;\n\n   Words : constant String_Vectors.Vector :=\n     To_Vector (\"PYTHON\", 1) &\n     To_Vector (\"COMPUTER\", 1) &\n     To_Vector (\"PROGRAMMING\", 1) &\n     To_Vector (\"KEYBOARD\", 1) &\n     To_Vector (\"MONITOR\", 1) &\n     To_Vector (\"SOFTWARE\", 1) &\n     To_Vector (\"HARDWARE\", 1) &\n     To_Vector (\"INTERNET\", 1) &\n     To_Vector (\"WEBSITE\", 1) &\n     To_Vector (\"DATABASE\", 1) &\n     To_Vector (\"ALGORITHM\", 1) &\n     To_Vector (\"FUNCTION\", 1) &\n     To_Vector (\"VARIABLE\", 1) &\n     To_Vector (\"DEBUGGING\", 1) &\n     To_Vector (\"TERMINAL\", 1);\n\n   type Hangman_Stage is array (Natural range 0 .. 7) of Unbounded_String;\n\n   Hangman_Stages : constant Hangman_Stage :=\n     (0 => To_Unbounded_String (\"\"),\n      1 => To_Unbounded_String (\"  +---+\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"=========\"),\n      2 => To_Unbounded_String (\"  +---+\" & ASCII.LF &\n                                \"  |   |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"=========\"),\n      3 => To_Unbounded_String (\"  +---+\" & ASCII.LF &\n                                \"  |   |\" & ASCII.LF &\n                                \"  O   |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"=========\"),\n      4 => To_Unbounded_String (\"  +---+\" & ASCII.LF &\n                                \"  |   |\" & ASCII.LF &\n                                \"  O   |\" & ASCII.LF &\n                                \"  |   |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"=========\"),\n      5 => To_Unbounded_String (\"  +---+\" & ASCII.LF &\n                                \"  |   |\" & ASCII.LF &\n                                \"  O   |\" & ASCII.LF &\n                                \" /|   |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"=========\"),\n      6 => To_Unbounded_String (\"  +---+\" & ASCII.LF &\n                                \"  |   |\" & ASCII.LF &\n                                \"  O   |\" & ASCII.LF &\n                                \" /|\\  |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"=========\"),\n      7 => To_Unbounded_String (\"  +---+\" & ASCII.LF &\n                                \"  |   |\" & ASCII.LF &\n                                \"  O   |\" & ASCII.LF &\n                                \" /|\\  |\" & ASCII.LF &\n                                \" / \\  |\" & ASCII.LF &\n                                \"      |\" & ASCII.LF &\n                                \"=========\"));\n\n   Max_Wrong : constant Natural := 6;\n\n   type Letter_Set is array (Character range 'A' .. 'Z') of Boolean;\n\n   function Is_Letter_In_Word (Letter : Character; Word : String) return Boolean is\n   begin\n      for I in Word'Range loop\n         if Word (I) = Letter then\n            return True;\n         end if;\n      end loop;\n      return False;\n   end Is_Letter_In_Word;\n\n   function Is_Word_Guessed (Word : String; Guessed : Letter_Set) return Boolean is\n   begin\n      for I in Word'Range loop\n         if not Guessed (Word (I)) then\n            return False;\n         end if;\n      end loop;\n      return True;\n   end Is_Word_Guessed;\n\n   procedure Display_Word (Word : String; Guessed : Letter_Set) is\n   begin\n      Put (\"Word: \");\n      for I in Word'Range loop\n         if Guessed (Word (I)) then\n            Put (Word (I) & \" \");\n         else\n            Put (\"_ \");\n         end if;\n      end loop;\n      New_Line;\n   end Display_Word;\n\n   procedure Print_Guessed_Letters (Guessed : Letter_Set) is\n      First : Boolean := True;\n   begin\n      Put (\"Guessed letters: \");\n      for Letter in Guessed'Range loop\n         if Guessed (Letter) then\n            if not First then\n               Put (\", \");\n            end if;\n            Put (Letter);\n            First := False;\n         end if;\n      end loop;\n      New_Line;\n   end Print_Guessed_Letters;\n\n   function Has_Guessed_Letters (Guessed : Letter_Set) return Boolean is\n   begin\n      for Letter in Guessed'Range loop\n         if Guessed (Letter) then\n            return True;\n         end if;\n      end loop;\n      return False;\n   end Has_Guessed_Letters;\n\n   function Play_Hangman return Boolean is\n      Word_Index : constant Word_Range := Random_Word.Random (Word_Gen);\n      Word : constant String := Words.Element (Word_Index - 1);\n      Guessed_Letters : Letter_Set := (others => False);\n      Wrong_Guesses : Natural := 0;\n      Input : String (1 .. 100);\n      Input_Length : Natural;\n      Guess : Character;\n   begin\n      Put_Line (\"Welcome to Hangman!\");\n      Put_Line (\"Guess the word letter by letter.\");\n\n      while Wrong_Guesses < Max_Wrong loop\n         New_Line;\n         Put_Line (To_String (Hangman_Stages (Wrong_Guesses)));\n\n         Display_Word (Word, Guessed_Letters);\n         Put_Line (\"Wrong guesses:\" & Natural'Image (Wrong_Guesses) &\n                   \"/\" & Natural'Image (Max_Wrong));\n\n         if Is_Word_Guessed (Word, Guessed_Letters) then\n            New_Line;\n            Put_Line (\"Congratulations! You guessed the word: \" & Word);\n            return True;\n         end if;\n\n         if Has_Guessed_Letters (Guessed_Letters) then\n            Print_Guessed_Letters (Guessed_Letters);\n         end if;\n\n         Put (\"Enter a letter: \");\n         Get_Line (Input, Input_Length);\n\n         if Input_Length /= 1 or else not Is_Letter (Input (1)) then\n            Put_Line (\"Please enter a single letter.\");\n         elsif Guessed_Letters (To_Upper (Input (1))) then\n            Put_Line (\"You already guessed that letter.\");\n         else\n            Guess := To_Upper (Input (1));\n            Guessed_Letters (Guess) := True;\n\n            if Is_Letter_In_Word (Guess, Word) then\n               Put_Line (\"Good guess! '\" & Guess & \"' is in the word.\");\n            else\n               Put_Line (\"Sorry, '\" & Guess & \"' is not in the word.\");\n               Wrong_Guesses := Wrong_Guesses + 1;\n            end if;\n         end if;\n      end loop;\n\n      New_Line;\n      Put_Line (To_String (Hangman_Stages (Wrong_Guesses)));\n      Put_Line (\"Game Over! The word was: \" & Word);\n      return False;\n   end Play_Hangman;\n\n   Play_Again_Input : String (1 .. 100);\n   Play_Again_Length : Natural;\n   Success : Boolean;\n\nbegin\n   Random_Word.Reset (Word_Gen);\n\n   loop\n      Success := Play_Hangman;\n      New_Line;\n      Put (\"Play again? (y/n): \");\n      Get_Line (Play_Again_Input, Play_Again_Length);\n\n      exit when Play_Again_Length = 0 or else\n                To_Lower (Play_Again_Input (1)) /= 'y';\n   end loop;\n\n   Put_Line (\"Thanks for playing!\");\nend Hangman;"
