    return True\n    83\u2192  | wrongGuesses state >= maxWrong state = do\n    84\u2192      putStrLn \"\"\n    85\u2192      putStrLn (hangmanStages !! wrongGuesses state)\n    86\u2192      putStrLn $ \"Game Over! The word was: \" ++ word state\n    87\u2192      return False\n    88\u2192  | otherwise = do\n    89\u2192      printGameState state\n    90\u2192      guess <- getValidGuess (guessedLetters state)\n    91\u2192      let newGuessed = guess : guessedLetters state\n    92\u2192      if guess `elem` word state\n    93\u2192        then do\n    94\u2192          putStrLn $ \"Good guess! '\" ++ [guess] ++ \"' is in the word.\"\n    95\u2192          gameLoop state { guessedLetters = newGuessed }\n    96\u2192        else do\n    97\u2192          putStrLn $ \"Sorry, '\" ++ [guess] ++ \"' is not in the word.\"\n    98\u2192          gameLoop state { guessedLetters = newGuessed, wrongGuesses = wrongGuesses state + 1 }\n    99\u2192\n   100\u2192playGame :: IO ()\n   101\u2192playGame = do\n   102\u2192  gen <- newStdGen\n   103\u2192  let randomWord = words' !! fst (randomR (0, length words' - 1) gen)\n   104\u2192  putStrLn \"Welcome to Hangman!\"\n   105\u2192  putStrLn \"Guess the word letter by letter.\"\n   106\u2192  _ <- gameLoop (initGameState randomWord)\n   107\u2192  return ()\n   108\u2192\n   109\u2192askPlayAgain :: IO Bool\n   110\u2192askPlayAgain = do\n   111\u2192  putStr \"\\nPlay again? (y/n): \"\n   112\u2192  response <- getLine\n   113\u2192  case response of\n   114\u2192    \"y\" -> return True\n   115\u2192    \"Y\" -> return True\n   116\u2192    \"n\" -> return False\n   117\u2192    \"N\" -> return False\n   118\u2192    _ -> askPlayAgain\n   119\u2192\n   120\u2192main :: IO ()\n   121\u2192main = do\n   122\u2192  playGame\n   123\u2192  continue <- askPlayAgain\n   124\u2192  if continue\n   125\u2192    then main\n   126\u2192    else putStrLn \"Thanks for playing!\"\n\n<system-reminder>\nWhenever you read a file, you should 