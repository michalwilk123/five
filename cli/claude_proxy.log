nvoid display_word(const char* word, char guessed_letters[], int num_guessed) {\n    printf(\"Word: \");\n    for (int i = 0; word[i] != '\\0'; i++) {\n        if (is_letter_guessed(word[i], guessed_letters, num_guessed)) {\n            printf(\"%c \", word[i]);\n        } else {\n            printf(\"_ \");\n        }\n    }\n    printf(\"\\n\");\n}\n\nint hangman_game() {\n    const char* word = words[rand() % MAX_WORDS];\n    char guessed_letters[MAX_GUESSES];\n    int num_guessed = 0;\n    int wrong_guesses = 0;\n    char input[10];\n    char guess;\n\n    printf(\"Welcome to Hangman!\\n\");\n    printf(\"Guess the word letter by letter.\\n\");\n\n    while (wrong_guesses < MAX_WRONG) {\n        printf(\"\\n%s\\n\", hangman_stages[wrong_guesses]);\n\n        display_word(word, guessed_letters, num_guessed);\n        printf(\"Wrong guesses: %d/%d\\n\", wrong_guesses, MAX_WRONG);\n\n        if (is_word_guessed(word, guessed_letters, num_guessed)) {\n            printf(\"\\nCongratulations! You guessed the word: %s\\n\", word);\n            return 1;\n        }\n\n        if (num_guessed > 0) {\n            print_guessed_letters(guessed_letters, num_guessed);\n        }\n\n        printf(\"Enter a letter: \");\n        if (fgets(input, sizeof(input), stdin) == NULL) {\n            continue;\n        }\n\n        if (strlen(input) != 2 || !isalpha(input[0])) {\n            printf(\"Please enter a single letter.\\n\");\n            continue;\n        }\n\n        guess = toupper(input[0]);\n\n        if (is_letter_guessed(guess, guessed_letters, num_guessed)) {\n            printf(\"You already guessed that letter.\\n\");\n            continue;\n        }\n\n        guessed_letters[num_guessed] = guess;\n        num_guessed++;\n\n        if (strchr(word, guess) != NULL) {\n            printf(\"Good guess! '%c' is in the word.\\n\", guess);\n        } else {\n            printf(\"Sorry, '%c' is not in the word.\\n\", guess);\n            wrong_guesses++;\n        }\n 