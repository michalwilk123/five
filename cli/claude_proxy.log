            "content": "import java.util.*;\n\npublic class Hangman {\n    private static final String[] WORDS = {\n        \"PYTHON\", \"COMPUTER\", \"PROGRAMMING\", \"KEYBOARD\", \"MONITOR\",\n        \"SOFTWARE\", \"HARDWARE\", \"INTERNET\", \"WEBSITE\", \"DATABASE\",\n        \"ALGORITHM\", \"FUNCTION\", \"VARIABLE\", \"DEBUGGING\", \"TERMINAL\"\n    };\n\n    private static final String[] HANGMAN_STAGES = {\n        \"\",\n        \"  +---+\\n      |\\n      |\\n      |\\n      |\\n      |\\n=========\",\n        \"  +---+\\n  |   |\\n      |\\n      |\\n      |\\n      |\\n=========\",\n        \"  +---+\\n  |   |\\n  O   |\\n      |\\n      |\\n      |\\n=========\",\n        \"  +---+\\n  |   |\\n  O   |\\n  |   |\\n      |\\n      |\\n=========\",\n        \"  +---+\\n  |   |\\n  O   |\\n /|   |\\n      |\\n      |\\n=========\",\n        \"  +---+\\n  |   |\\n  O   |\\n /|\\\\  |\\n      |\\n      |\\n=========\",\n        \"  +---+\\n  |   |\\n  O   |\\n /|\\\\  |\\n /    |\\n      |\\n=========\",\n        \"  +---+\\n  |   |\\n  O   |\\n /|\\\\  |\\n / \\\\  |\\n      |\\n=========\"\n    };\n\n    private static final int MAX_WRONG = 6;\n    private static final Random random = new Random();\n    private static final Scanner scanner = new Scanner(System.in);\n\n    public static void main(String[] args) {\n        do {\n            playHangman();\n            System.out.print(\"\\nPlay again? (y/n): \");\n            String playAgain = scanner.nextLine().toLowerCase();\n            if (!playAgain.equals(\"y\")) {\n                System.out.println(\"Thanks for playing!\");\n                break;\n            }\n        } while (true);\n\n        scanner.close();\n    }\n\n    private static void playHangman() {\n        String word = WORDS[random.nextInt(WORDS.length)];\n        Set<Character> guessedLetters = new HashSet<>();\n        int wrongGuesses = 0;\n\n        System.out.println(\"Welcome to Hangman!\");\n        System.out.println(\"Guess the word letter by letter.\");\n\n        while (wrongGuesses < MAX_WRONG) {\n            System.out.println(\"\\n\" + HANGMAN_STAGES[wrongGuesses]);\n\n            displayWord(word, guessedLetters);\n            System.out.println(\"Wrong guesses: \" + wrongGuesses + \"/\" + MAX_WRONG);\n\n            if (isWordGuessed(word, guessedLetters)) {\n                System.out.println(\"\\nCongratulations! You guessed the word: \" + word);\n                return;\n            }\n\n            if (!guessedLetters.isEmpty()) {\n                displayGuessedLetters(guessedLetters);\n            }\n\n            char guess = getGuess(guessedLetters);\n            guessedLetters.add(guess);\n\n            if (word.indexOf(guess) != -1) {\n                System.out.println(\"Good guess! '\" + guess + \"' is in the word.\");\n            } else {\n                System.out.println(\"Sorry, '\" + guess + \"' is not in the word.\");\n                wrongGuesses++;\n            }\n        }\n\n        System.out.println(\"\\n\" + HANGMAN_STAGES[wrongGuesses]);\n        System.out.println(\"Game Over! The word was: \" + word);\n    }\n\n    private static void displayWord(String word, Set<Character> guessedLetters) {\n        System.out.print(\"Word: \");\n        for (char letter : word.toCharArray()) {\n            if (guessedLetters.contains(letter)) {\n                System.out.print(letter + \" \");\n            } else {\n                System.out.print(\"_ \");\n            }\n        }\n        System.out.println();\n    }\n\n    private static boolean isWordGuessed(String word, Set<Character> guessedLetters) {\n        for (char letter : word.toCharArray()) {\n            if (!guessedLetters.contains(letter)) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    private static void displayGuessedLetters(Set<Character> guessedLetters) {\n        List<Character> sortedLetters = new ArrayList<>(guessedLetters);\n        Collections.sort(sortedLetters);\n        System.out.print(\"Guessed letters: \");\n        for (int i = 0; i < sortedLetters.size(); i++) {\n            System.out.print(sortedLetters.get(i));\n            if (i < sortedLetters.size() - 1) {\n                System.out.print(\", \");\n            }\n        }\n        System.out.println();\n    }\n\n    private static char getGuess(Set<Character> guessedLetters) {\n        while (true) {\n            System.out.print(\"Enter a letter: \");\n            String input = scanner.nextLine().toUpperCase().trim();\n\n            if (input.length() != 1 || !Character.isLetter(input.charAt(0))) {\n                System.out.println(\"Please enter a single letter.\");\n                continue;\n            }\n\n            char guess = input.charAt(0);\n\n            if (guessedLetters.contains(guess)) {\n                System.out.println(\"You already guessed that letter.\");\n                continue;\n            }\n\n            return guess;\n        }\n    }\n}"
